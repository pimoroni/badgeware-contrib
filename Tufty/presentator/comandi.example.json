{
  "groups": [
    {
      "name": "Websites",
      "commands": [
        {"name": "Pimoroni", "url": "https://shop.pimoroni.com"},
        {"name": "Badgeware", "url": "https://badgewa.re"},
        {"name": "YouTube", "url": "https://www.youtube.com"}
      ]
    },
    {
      "name": "Texts",
      "commands": [
        {"name": "Notepad: greeting", "open": "notepad",
         "text": "Good morning everyone!\nToday: electronics and programming."},
        {"name": "Email signature", "text": "Alex Example\nExample Makerspace"},
        {"name": "Character test", "open": "notepad",
         "text": "abc ABC 123 !\"#$%&'()*+,-./:;<=>?@[\\]^_{|}\n"}
      ]
    },
    {
      "name": "Shortcuts",
      "commands": [
        {"name": "Show desktop", "keys": "WIN+D"},
        {"name": "File Explorer", "keys": "WIN+E"},
        {"name": "Lock PC", "keys": "WIN+L"},
        {"name": "Calculator", "steps": [["keys", "WIN+R"], ["pause", 500],
                                         ["text", "calc"], ["keys", "ENTER"]]},
        {"name": "Volume up", "keys": "VOLUP VOLUP VOLUP"},
        {"name": "Volume down", "keys": "VOLDOWN VOLDOWN VOLDOWN"},
        {"name": "Mute", "keys": "MUTE"}
      ]
    }
  ]
}
